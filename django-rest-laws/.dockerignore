# Игнорируем системные и редакторные файлы
**/.DS_Store
**/.venv
**/.vscode
**/.idea
**/*.swp
**/*.swo
*~

# Игнорируем виртуальные окружения (они создаются на хосте и не нужны в контейнере)
venv/
.venv/

# Игнорируем сам Dockerfile (опционально, но часто нужно для многоэтапных сборок)
#Dockerfile
#docker-compose.yml

# Игнорируем логи и кэш
*.log
.pytest_cache
.mypy_cache
.coverage
htmlcov/

# Игнорируем временные и медиа файлы, созданные при локальной разработке
media/
logs/
tmp/
temp/
uploads/

# --- САМОЕ ВАЖНОЕ: Игнорируем исходный код Python, но НЕ игнорируем requirements.txt ---
# Игнорируем кэш интерпретатора Python
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd

# Игнорирует файлы специфичные для Python
.Python
pyvenv.cfg
pip-log.txt